# Демо-сборка: `npm run build:demo`. Бэкенд не нужен.
#
# ВНИМАНИЕ: пустой VITE_API_BASE_URL включает мок на localStorage — у каждого,
# кто откроет, свои 9999 моггсов и ненастоящие промокоды. Это сборка для показа,
# на боевой домен её заливать нельзя.

VITE_BASE_PATH=/
VITE_API_BASE_URL=

VITE_MANAGER_USERNAME=ceo_trauma
VITE_SUPPORT_USERNAME=ceo_trauma
