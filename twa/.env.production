# Боевая сборка для looksmaxx.ru. Подхватывается обычным `npm run build`.
# Значения — это пути на твоём домене, а не выданные кем-то ключи.

# Приложение лежит в /web/, поэтому ссылки на скрипты, стили и шрифты идут с этим префиксом.
VITE_BASE_PATH=/web/

# API на том же домене в /api/. Путь относительный: домен подставит браузер,
# межсайтовых запросов нет и CORS не участвует.
VITE_API_BASE_URL=/api

# Куда ведут кнопки «написать менеджеру» и «поддержка».
VITE_MANAGER_USERNAME=ceo_trauma
VITE_SUPPORT_USERNAME=ceo_trauma
