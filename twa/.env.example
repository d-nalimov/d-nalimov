# Этот файл нужен, только если хочется переопределить настройки локально:
# скопируйте в .env (он в .gitignore) и правьте.
#
# Готовые наборы уже лежат рядом и подхватываются сами:
#   npm run build       -> .env.production, боевая сборка для looksmaxx.ru/web/
#   npm run build:demo  -> .env.demo, показ без бэкенда (мок в localStorage)
#   npm run dev         -> .env, если он есть; иначе мок

# Пусто -> приложение работает на mock-бэкенде (localStorage), удобно для разработки.
# Указан -> все запросы уходят на реальный backend с заголовком Authorization: tma <initData>.
# На looksmaxx.ru фронт и API на одном домене, поэтому путь относительный:
# VITE_API_BASE_URL=/api
VITE_API_BASE_URL=

# Ссылки, которые открываются из приложения
VITE_MANAGER_USERNAME=ceo_trauma
VITE_SUPPORT_USERNAME=ceo_trauma

# Базовый путь сборки. На looksmaxx.ru приложение лежит в /web/:
# VITE_BASE_PATH=/web/
VITE_BASE_PATH=/
