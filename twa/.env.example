# Пусто -> приложение работает на mock-бэкенде (localStorage), удобно для разработки и демо.
# Указан -> все запросы уходят на реальный backend с заголовком Authorization: tma <initData>.
# На looksmaxx.ru фронт и API на одном домене, поэтому путь относительный:
# VITE_API_BASE_URL=/api
VITE_API_BASE_URL=

# Ссылки, которые открываются из приложения
VITE_MANAGER_USERNAME=ceo_trauma
VITE_SUPPORT_USERNAME=ceo_trauma

# Базовый путь сборки. На looksmaxx.ru приложение лежит в /web/:
# VITE_BASE_PATH=/web/
VITE_BASE_PATH=/
