# Токен бота — им проверяется подпись initData. Без него приложение не стартует.
BOT_TOKEN=123456:AA...

# Кому открывать CORS: домен, с которого раздаётся мини-приложение.
ALLOWED_ORIGINS=https://example.github.io

# SQLite для локальной разработки, PostgreSQL для прода:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/cashyou
DATABASE_URL=sqlite+aiosqlite:///./cashyou.db

# Разовая оплата доступа: сумма в копейках.
PRICE_AMOUNT=499000
PRICE_CURRENCY=RUB

# Экономика бонусов
SPIN_COST=100
PROMO_TTL_DAYS=30
PURCHASE_BONUS_MOGGS=100

# Контакты, которые приложение показывает пользователю
MANAGER_USERNAME=ceo_trauma
COMMUNITY_URL=https://t.me/cashyou_club

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты (ссылка на мини-приложение)
YOOKASSA_RETURN_URL=https://t.me/cashyou_menu_bot/app

# Окружение: development | production
ENV=development
# ОПАСНО: принимает "Authorization: tma dev:<telegram_id>" без подписи.
# Работает только при ENV=development, на проде запуск будет прерван.
AUTH_DEV_MODE=false
