# Мини-приложение и его API на одном домене:
#   https://looksmaxx.ru/web/   — статика из twa/dist
#   https://looksmaxx.ru/api/   — FastAPI на 127.0.0.1:8000
#
# Один origin — межсайтовых запросов нет, CORS не участвует.
# Класть рядом с конфигом основного сайта, не переписывая его.

server {
    listen 443 ssl http2;
    server_name looksmaxx.ru;

    # ssl_certificate ... — оставить как у основного сайта.

    # --- Мини-приложение ---
    location /web/ {
        alias /var/www/cashyou/;
        index index.html;
        # Роутер приложения работает через #, поэтому запасной вариант нужен
        # только для прямых заходов на несуществующий файл.
        try_files $uri $uri/ /web/index.html;

        # Хеш в имени файла меняется при каждой сборке — кэшируем надолго.
        location ~* ^/web/(assets|fonts)/ {
            alias /var/www/cashyou/;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # index.html кэшировать нельзя: иначе после выкатки останется старая сборка.
    location = /web/index.html {
        alias /var/www/cashyou/index.html;
        add_header Cache-Control "no-store";
    }

    # --- API мини-приложения ---
    # Слеш в конце proxy_pass срезает префикс: /api/auth уходит в приложение как /auth.
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Вебхук ЮKassa приходит сюда же: https://looksmaxx.ru/api/payments/webhook
        proxy_read_timeout 30s;
    }

    # Всё остальное — существующий сайт, его блок не трогаем.
}
