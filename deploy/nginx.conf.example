# Мини-приложение и его API на уже занятом домене.
#
#   https://looksmaxx.ru/web/   — статика из twa/dist
#   https://looksmaxx.ru/api/   — FastAPI на 127.0.0.1:8000
#
# Это фрагмент, а не самостоятельный конфиг: конфигурацию основного сайта
# не редактируем, а подключаем этот файл одной строкой внутрь его блока
# server, который слушает 443:
#
#   include /etc/nginx/snippets/cashyou.conf;
#
# Фронт и API на одном домене, поэтому межсайтовых запросов нет
# и CORS в этой схеме не участвует.

# --- Мини-приложение ---
location /web/ {
    alias /var/www/cashyou/;
    index index.html;
    # Роутер приложения работает через #, поэтому запасной вариант нужен
    # только для прямых заходов на несуществующий файл.
    try_files $uri $uri/ /web/index.html;
}

# Имена файлов содержат хеш сборки, поэтому их можно кэшировать надолго.
location ~* ^/web/(assets|fonts)/ {
    alias /var/www/cashyou/;
    expires 1y;
    add_header Cache-Control "public, immutable";
}

# А index.html кэшировать нельзя: иначе после выкатки у людей останется
# старая версия, ссылающаяся на уже удалённые файлы.
location = /web/index.html {
    alias /var/www/cashyou/index.html;
    add_header Cache-Control "no-store";
}

# --- API мини-приложения ---
location /api/ {
    # Слеш в конце обязателен: он срезает префикс, и /api/auth приходит
    # в приложение как /auth. Без слеша все вызовы вернут 404.
    proxy_pass http://127.0.0.1:8000/;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Сюда же приходит уведомление ЮKassa:
    # https://looksmaxx.ru/api/payments/webhook
    proxy_read_timeout 30s;
}
